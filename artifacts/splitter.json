,\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"ideaTotal\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"mainBurned\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"mainBurner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"payOut\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"agents_\",\"type\":\"address\"}],\"name\":\"setAgents\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"treasury_\",\"type\":\"address\"}],\"name\":\"setTreasury\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"sync\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"treasury\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"treasuryAccrued\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"stateMutability\":\"payable\",\"type\":\"receive\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"title\":\"FeeSplitter\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"burnIdleIdeaShare()\":{\"notice\":\"Use it or lose it: an idea share left unclaimed for IDEA_GRACE buys the main token at the market and         burns it. Anyone can call.\"},\"claimIdea()\":{\"notice\":\"Pays the idea contract its share. If its receive reverts, only this call reverts.\"},\"payOut()\":{\"notice\":\"Pays the agents' and the treasury's shares. Anyone can pay the gas.\"},\"sync()\":{\"notice\":\"Books the ETH that arrived since the last call into the shares. Anyone can call, but not from inside a         payout: while one is under way the balance is mid-transfer and must not be booked again.\"}},\"notice\":\"The creator fee recipient of a pool whose hook is Programmable's EthereumNative30HookV3: the kernel's fee         vault pays the garage's share here (anyone can call the vault's claimCreator), and sync() books what         arrived. With an idea contract (an agent token): 80% is the idea's, 10% the agents' work wallet's and 10%         the treasury's; an idea share left unclaimed for a day can be spent by anyone on buying back and burning         the garage's main token. Without one (the main token): half to the agents, half to the treasury.         Anyone can pay out; each share only goes to its own address. The treasury can change the agents' and         the treasury's address, so the fees can move to a new wallet if a key ever has to be rotated; nothing here         can change the fee or the shares.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/FeeSplitter.sol\":\"FeeSplitter\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"none\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/\",\":@uniswap/v4-core/=lib/v4-periphery/lib/v4-core/\",\":@uniswap/v4-periphery/=lib/v4-periphery/\"],\"viaIR\":true},\"sources\":{\"src/FeeSplitter.sol\":{\"keccak256\":\"0xb27a21502b27de241d7cec1a2501e30c8d669c0aea5d9f291585250183dc78e2\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://e719a4c55914d075d9d675786d175d207bb93ddfbe2e9bf523b8148f86274396\",\"dweb:/ipfs/QmYhbiX4ofo3R2X8S9ZE8udh2SxrpBYbtreNsiuigxMLjc\"]}},\"version\":1}"}
